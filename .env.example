# ==============================================================================
# DevLens AI - Environment Configuration Example
# Copy this file to .env.local for local development, or add these in Vercel project settings:
# Settings -> Environment Variables
# ==============================================================================

# Gemini API Key (Required)
# Used for AI profile intelligence, career matchmaking, roast generation & roadmaps.
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Token (Recommended)
# Increases GitHub API rate limits from 60 req/hr (unauthenticated) to 5,000 req/hr.
# Generate a Personal Access Token (classic with 'public_repo' or fine-grained read-only):
# https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Base URL (Optional)
# Optional in production — DevLens automatically detects VERCEL_URL on Vercel deployments.
# NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app
